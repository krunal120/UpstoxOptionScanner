{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/niftyquant-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "DatabaseProvider": "SqlServer",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLSERVER2022_2;Database=NiftyQuantDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Upstox": {
    "BaseUrl": "https://api.upstox.com",
    "WebSocketUrl": "wss://api.upstox.com/v3/feed/market-data-feed",
    "ApiKey": "",
    "ApiSecret": "",
    "RedirectUri": "http://localhost:5000/api/auth/callback"
  },
  "MegaBull": {
    "BaseUrl": "https://api.megabull.in",
    "ApiKey": "453afc9b-2766-4e76-9ef2-db1fca69b5bb",
    "IsEnabled": true
  },
  "TradingRisk": {
    "InitialCapital": 50000.0,
    "RiskPerTradePercent": 3.0,
    "MaxDailyLossPercent": 6.0,
    "MinRewardRiskRatio": 2.0,
    "MaxConcurrentPositions": 1,
    "MaxDailyTrades": 6,
    "MaxConsecutiveLosses": 2,
    "EnableTrailingStopLoss": true,
    "SlippagePerOrderPercent": 0.2,
    "BrokeragePerOrder": 20.0
  },
  "AllowedHosts": "*"
}
